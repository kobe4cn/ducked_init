{
  "name": "duckdb_crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "tenant:create": "node --env-file-if-exists=.env --import tsx scripts/create-tenant.ts",
    "operator:create": "node --env-file-if-exists=.env --import tsx scripts/create-operator.ts",
    "dispatcher": "node --env-file-if-exists=.env --import tsx scripts/run-dispatcher.ts",
    "task:enqueue": "node --env-file-if-exists=.env --import tsx scripts/enqueue-task.ts",
    "lake:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-lake.ts",
    "lake:reset": "node --env-file-if-exists=.env --import tsx scripts/reset-lake.ts",
    "operator:reset-totp": "node --env-file-if-exists=.env --import tsx scripts/reset-operator-totp.ts",
    "check": "node --env-file=.env --import tsx src/00_check.ts",
    "seed": "node --env-file=.env --import tsx src/01_seed.ts",
    "ingest": "node --env-file=.env --import tsx src/02_ingest.ts",
    "ingest:incr": "node --env-file=.env --import tsx src/02_ingest.ts incremental",
    "model": "node --env-file=.env --import tsx src/03_model.ts",
    "crm": "node --env-file=.env --import tsx src/04_crm.ts",
    "journey": "node --env-file=.env --import tsx src/05_journey.ts",
    "realtime": "node --env-file=.env --import tsx src/06_realtime.ts",
    "federation": "node --env-file=.env --import tsx src/07_federation_ducklake.ts",
    "v2": "node --env-file=.env --import tsx src/08_v2_features.ts",
    "advanced": "node --env-file=.env --import tsx src/09_advanced_sql.ts",
    "engineering": "node --env-file=.env --import tsx src/10_engineering.ts",
    "extensions": "node --env-file=.env --import tsx src/11_extensions.ts",
    "lakeformats:make": "python3 scripts/make_delta_iceberg.py",
    "wasm:build": "pnpm --dir wasm install && pnpm --dir wasm run build",
    "wasm:data": "node --env-file=.env --import tsx src/lib/export-web.ts",
    "wasm:serve": "pnpm --dir wasm run serve",
    "dbt": "cd dbt && CRM_DB_FILE=${CRM_DB_FILE:-../data/crm.duckdb} dbt build --profiles-dir .",
    "all": "pnpm check && pnpm seed && pnpm ingest && pnpm ingest:incr && pnpm model && pnpm crm && pnpm journey && pnpm realtime && pnpm federation",
    "report": "node --import tsx src/report.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@duckdb/node-api": "1.5.5-r.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "1.0.0-rc.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "resend": "^6.30.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "1.0.0-rc.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.2"
  }
}
