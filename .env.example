# 复制为 .env 后按本机的 PG / 对象存储修改：cp .env.example .env
# 以下账号均为本地开发容器的默认值（对象存储账号见 db_script/docker-compose.yml 中 SeaweedFS 的 AWS_*）

# ============ 规模 ============
# SCALE=1     → 1000 万会员 / 约 1.3 亿订单 / 约 2.8 亿明细 / 约 1 亿埋点 / 5000 万触达
# SCALE=0.1   → 100 万会员 / 约 1300 万订单（笔记本推荐先跑这个）
# SCALE=0.01  → 10 万会员 / 约 130 万订单（几分钟跑完，验证环境）
SCALE=1

# 业务数据写到哪里：pg = 写入 PostgreSQL，再从 PG 入湖（完整链路）
#                   lake = 跳过 PG，直接生成“已导出”的 Parquet（纯湖上压测，省 PG 磁盘）
SEED_TARGET=pg

# ============ PostgreSQL（你本地容器）============
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=crm
PG_USER=crm
PG_PASSWORD=crm
PG_SCHEMA=crm

# ============ 对象存储 ============
# SeaweedFS: localhost:8333    RustFS: localhost:9000    Garage: localhost:3900
# 阿里云 OSS: oss-cn-hangzhou.aliyuncs.com（S3_URL_STYLE=vhost, S3_USE_SSL=true）
S3_ENDPOINT=localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=crm
S3_SECRET_KEY=crm-secret
S3_URL_STYLE=path
S3_USE_SSL=false

# 数据湖根目录：对象存储或本地目录（如 ./data/lake）
LAKE_URI=s3://crm-lake/lake

# ============ DuckDB ============
DB_FILE=./data/crm.duckdb
DUCKDB_TEMP_DIR=./data/tmp
# DUCKDB_THREADS=8          # 默认 = CPU 核数
# DUCKDB_MEMORY=24GB        # 默认 = 物理内存的 60%
# 10_engineering 加密演示用的密钥（32 字节）；不配置时用代码里的演示密钥
# PII_KEY=
# 11_extensions 向量索引演示的向量条数，默认 30 万
# VSS_ROWS=300000

# ============ 模拟会员接口 ============
MOCK_API_PORT=18080
MOCK_API_PAGE_SIZE=20000
MOCK_API_CONCURRENCY=4

# ============ 多租户平台（app/）============
# 平台元数据库（租户、成员、会话等），与上面的演示数据分开建库
PLATFORM_DATABASE_URL=postgres://crm:crm@localhost:5432/crm_platform
# 登录邮件里链接使用的站点地址：生产环境必填；开发环境不填时取请求地址
# APP_ORIGIN=http://localhost:5173
# Magic Link 申请限流：同一邮箱每个时间窗口（分钟）内最多申请几次
MAGIC_LINK_RATE_LIMIT=5
MAGIC_LINK_RATE_WINDOW_MINUTES=15

# 运营后台 /ops 的 IP 白名单（逗号分隔的 CIDR 或单个地址），不配置时不限制；
# 客户端地址取 OPS_CLIENT_IP_HEADER（默认 X-Forwarded-For）的最后一项，必须部署在反向代理之后，否则可被伪造
# OPS_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
# OPS_CLIENT_IP_HEADER=x-forwarded-for
# 生产构建（npm run start）下把登录邮件输出到日志；开发环境不需要
# MAILER=console

# 租户数据湖的根：本地目录或对象存储（s3://bucket/prefix）。在对象存储上时，上面的 S3_* 是平台账号：
# 开通租户时用它经存储服务的 IAM API 为每个租户建只能访问本租户前缀的账号（SeaweedFS 需开启 -s3.iam.readOnly=false），
# 工作进程只拿到租户账号。
# 存储前缀在开通租户时写入平台库，修改后只影响之后开通的租户；已开通的租户用 pnpm lake:migrate 搬过去（见 README） #./data/platform-lake
PLATFORM_LAKE_URI=s3://crm-lake/platform 
# 凭据信封加密的主密钥（必填，32 字节 base64）：数据源密码等用每个租户的数据密钥加密，数据密钥再用它包裹。
# 生成：openssl rand -base64 32。平台与调度器须配置同一个值；丢失后已保存的凭据无法解密，只能重新填写
PLATFORM_MASTER_KEY=
# 本机 DuckDB 文件类数据源所在的目录：每个租户只能登记 <目录>/<租户 ID>/ 下的文件。不配置时只能登记对象存储上的 DuckDB 文件
# PLATFORM_SOURCE_FILES_DIR=./data/source-files
# 没有水位线字段（更新时间或自增主键）、行数达到这个值的大表全量比对时默认每天同步一次（其余每小时），默认 1000 万
# SOURCE_LARGE_TABLE_ROWS=10000000
# 调度器（npm run dispatcher）所在机器同时运行的工作进程上限
PLATFORM_MAX_WORKERS=4

# ============ 测试（npm test）============
# vitest 不读本文件：测试用平台 PG 固定为 crm_platform_test（可在命令行用 TEST_PLATFORM_DATABASE_URL 覆盖），
# 租户数据湖用系统临时目录，不会碰上面的 PLATFORM_*。在对象存储上跑隔离测试：
#   TEST_S3_LAKE_URI=s3://crm-lake/platform-test npm test
# MySQL 数据源测试需要一个能建库建用户的账号（主机写 127.0.0.1，localhost 会被当作本机 socket）：
#   TEST_MYSQL_URL=mysql://root:密码@127.0.0.1:3306/crm_source_test npm test
# MongoDB 数据源测试需要一个能建库建用户的账号（本地容器见 README）：
#   TEST_MONGO_URL='mongodb://crm:crm-secret@localhost:27017/crm_source_test?authSource=admin' npm test
